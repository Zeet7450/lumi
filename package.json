{
  "name": "lumi",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @lumi/web dev --hostname 127.0.0.1",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop",
    "supabase:migrations": "supabase migration list --local",
    "supabase:reset": "supabase db reset --local --no-seed",
    "supabase:test": "supabase test db --local",
    "supabase:advisors": "supabase db lint --local --schema public --level error --fail-on error",
    "setup:local-env": "node scripts/setup-local-env.mjs",
    "seed:demo": "pnpm --filter @lumi/government build && node backend/government/dist/scripts/seed-demo.js",
    "start:government:local": "pnpm --filter @lumi/government build && pnpm --filter @lumi/government start:local",
    "build:ops": "LUMI_ENTRY=ops LUMI_DIST_DIR=.next-ops pnpm --filter @lumi/web build",
    "build:warga": "LUMI_ENTRY=warga LUMI_DIST_DIR=.next-warga pnpm --filter @lumi/web build",
    "build:simulator": "LUMI_ENTRY=simulator LUMI_DIST_DIR=.next-simulator pnpm --filter @lumi/web build",
    "start:ops": "LUMI_ENTRY=ops LUMI_DIST_DIR=.next-ops pnpm --filter @lumi/web start --port 3000",
    "start:warga": "LUMI_ENTRY=warga LUMI_DIST_DIR=.next-warga pnpm --filter @lumi/web start --port 3001",
    "start:simulator": "LUMI_ENTRY=simulator LUMI_DIST_DIR=.next-simulator pnpm --filter @lumi/web start --port 3002",
    "build": "pnpm --filter @lumi/contracts build && pnpm --filter @lumi/government build && pnpm --filter @lumi/web build",
    "typecheck": "pnpm --filter @lumi/contracts build && pnpm --filter @lumi/government build && pnpm --filter @lumi/web lint",
    "test": "node --test scripts/supabase-config.test.mjs && pnpm --filter @lumi/contracts test && pnpm --filter @lumi/government test && pnpm --filter @lumi/web test",
    "lint": "pnpm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "supabase": "2.117.0",
    "typescript": "^5.8.0"
  }
}
