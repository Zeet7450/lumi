# Stage 1 local foundation. Use root `pnpm setup:local-env`; never commit the
# generated `.env.local` or copy secret values into this template.
NODE_ENV=development
PORT=4000
LUMI_STORAGE=memory
LUMI_OPS_ORIGIN=http://localhost:3000

DEMO_PASSWORD=generated-locally
LUMI_SESSION_HMAC_KEY=generated-locally
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=from-local-supabase-status
SUPABASE_SECRET_KEY=from-local-supabase-status
LUMI_DATABASE_URL=from-local-supabase-status
