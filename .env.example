# Copying this file is not required. `pnpm setup:local-env` creates an ignored,
# mode-0600 `.env.local` from the running local Supabase stack without printing
# any value. Never commit the generated file.

# --- Ops demo credentials (generated locally, never committed) ---
DEMO_PASSWORD=generated-locally
LUMI_SESSION_HMAC_KEY=generated-locally

# --- Supabase (local stack via Docker; values from `supabase status -o env`) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=from-local-supabase-status
SUPABASE_SECRET_KEY=from-local-supabase-status
LUMI_DATABASE_URL=from-local-supabase-status

# --- Backend runtime ---
# Exact origin of the dashboard web app. Mandatory in production.
LUMI_OPS_ORIGIN=http://localhost:3000
# Stage 1 preserves the fixture runtime until the Stage 2 persistence adapter.
LUMI_STORAGE=memory

# --- Next.js web app (per-entry builds; see package.json scripts) ---
LUMI_ENTRY=ops
LUMI_DIST_DIR=.next-ops

# --- Client-side values (safe to expose: publishable only) ---
NEXT_PUBLIC_LUMI_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_LUMI_STATE_ORIGIN=http://127.0.0.1:3100
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=from-local-supabase-status
