# Do not commit real values. These are required only to run the HTTP server.
LUMI_SESSION_HMAC_KEY=replace-with-at-least-32-random-characters
LUMI_DEMO_PASSWORD_DLH=replace-with-a-demo-password-of-at-least-12-characters
LUMI_DEMO_PASSWORD_BPBD=replace-with-a-demo-password-of-at-least-12-characters
LUMI_DEMO_PASSWORD_DINKES=replace-with-a-demo-password-of-at-least-12-characters
LUMI_DEMO_PASSWORD_DISKOMINFO=replace-with-a-demo-password-of-at-least-12-characters
LUMI_DEMO_PASSWORD_CITIZEN=replace-with-a-demo-password-of-at-least-12-characters
LUMI_DEMO_PASSWORD_ADMIN=replace-with-a-demo-password-of-at-least-12-characters
# Exact origin of the later dashboard web app. Mandatory in production.
LUMI_OPS_ORIGIN=http://localhost:3000
# Memory storage is intentional for local fixture/demo verification.
LUMI_STORAGE=memory
# Set only when a later deployment injects an SSL Supabase PostgreSQL connection.
# LUMI_DATABASE_URL=
