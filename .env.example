# Copying this file is not required. `pnpm setup:local-env` creates an ignored,
# mode-0600 `.env.local` from the running local Supabase stack without printing
# any value. Never commit the generated file.
DEMO_PASSWORD=generated-locally
LUMI_SESSION_HMAC_KEY=generated-locally
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=from-local-supabase-status
SUPABASE_SECRET_KEY=from-local-supabase-status
LUMI_DATABASE_URL=from-local-supabase-status
# Exact origin of the later dashboard web app. Mandatory in production.
LUMI_OPS_ORIGIN=http://localhost:3000
# Stage 1 preserves the fixture runtime until the Stage 2 persistence adapter.
LUMI_STORAGE=memory
